{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kayal",
  "compatibility_date": "2026-08-14",
  "main": "./dist/worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "kayal.com.au", "custom_domain": true },
    { "pattern": "www.kayal.com.au", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "bobinthomas",
    "GITHUB_REPO": "kayal",
    "GITHUB_BRANCH": "main"
  },
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
